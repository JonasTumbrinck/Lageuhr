<Project Sdk="Microsoft.NET.Sdk">
  <!-- .NET Framework 4.8 ist auf jedem Windows 10/11 vorhanden: eine einzelne kleine .exe, keine Installation. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Lageuhr</AssemblyName>
    <RootNamespace>Lageuhr</RootNamespace>
    <Version>1.4.2</Version>
    <Product>Lageuhr</Product>
    <AssemblyTitle>Lageuhr – Overlay mit taktischer Zeit</AssemblyTitle>
    <ApplicationIcon>lageuhr.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
</Project>
